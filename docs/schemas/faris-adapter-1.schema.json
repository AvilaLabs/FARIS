{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AvilaLabs/FARIS/blob/main/docs/schemas/faris-adapter-1.schema.json",
  "title": "FARIS adapter declaration, contract faris-adapter-contract/v1",
  "description": "What an adapter for an external tool declares (docs/ADAPTER_CONTRACT.md, requirement AUTO-060).",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "name", "tool_versions", "inputs", "outputs", "units", "receipt", "cancellation", "failures", "entry_points"],
  "properties": {
    "contract": {"const": "faris-adapter-contract/v1"},
    "name": {"type": "string", "minLength": 1},
    "tool_versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tested", "accepted", "check"],
      "properties": {
        "tested": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "accepted": {"type": "string", "minLength": 1},
        "check": {"enum": ["refuses", "records_only"]}
      }
    },
    "inputs": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "carried_by", "format", "unit"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "carried_by": {"type": "string", "minLength": 1},
          "format": {"type": "string", "minLength": 1},
          "unit": {"type": "string", "minLength": 1}
        }
      }
    },
    "outputs": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "format", "unit", "label"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "format": {"type": "string", "minLength": 1},
          "unit": {"type": "string", "minLength": 1},
          "label": {"enum": ["calculated", "checked", "authored", "literature", "conditional"]}
        }
      }
    },
    "units": {"type": "string", "minLength": 1},
    "receipt": {
      "type": "array", "minItems": 1,
      "items": {"enum": ["tool_path", "tool_sha256", "tool_version", "input_sha256", "arguments", "limits", "exit_status", "execution_status", "elapsed_seconds", "output_sha256"]},
      "uniqueItems": true
    },
    "cancellation": {"type": "string", "minLength": 1},
    "failures": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["mode", "reported_as", "next_step"],
        "properties": {
          "mode": {"type": "string", "minLength": 1},
          "reported_as": {"type": "string", "minLength": 1},
          "next_step": {"type": "string", "minLength": 1}
        }
      }
    },
    "entry_points": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
