{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:avila-labs:faris:schema:evidence-store-index:1",
  "title": "Embedded evidence store index (evidence-store/store.json)",
  "description": "The index of the content-addressed Core evidence store (Avila Core ADR-0028, avila.core/evidence-store/v0.1) that a study file embeds when it packs store evidence. Unknown properties are refused, as the FARIS verifier does.",
  "type": "object",
  "required": ["schema_version", "codec", "trees"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string" },
    "codec": { "type": "string" },
    "trees": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "files"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["path", "sha256", "bytes"],
              "additionalProperties": false,
              "properties": {
                "path": { "type": "string" },
                "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                "bytes": { "type": "integer", "minimum": 0 }
              }
            }
          }
        }
      }
    }
  }
}
