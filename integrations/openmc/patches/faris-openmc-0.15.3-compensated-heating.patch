 class Tally {
 public:
+  static_assert(std::numeric_limits<long double>::digits == 64,
+    "NUC-013 checkpoint encoding requires x87 64-bit long double precision");
+  struct Nuc013Compensator {
+    long double sum {0.0L};
+    long double correction {0.0L};
+    void add(long double x)
+    {
+      long double t = sum + x;
+      correction += (std::fabs(sum) >= std::fabs(x))
+                      ? (sum - t) + x
+                      : (x - t) + sum;
+      sum = t;
+    }
+    long double value() const { return sum + correction; }
+    void clear() { sum = correction = 0.0L; }
+  };
