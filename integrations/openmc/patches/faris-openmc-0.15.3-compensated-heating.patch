 void Tally::reset()
 {
   n_realizations_ = 0;
+  if (nuc013_compensation_) {
+    if (nuc013_event_by_thread_.size() !=
+        static_cast<std::size_t>(num_threads())) {
+      fatal_error("NUC-013 OpenMP thread count changed after tally initialization");
+    }
+    for (auto& lane : nuc013_event_by_thread_)
+      lane.clear();
+    nuc013_sum_.clear();
+    nuc013_sum_sq_.clear();
+  }
   if (results_.size() != 0) {
     xt::view(results_, xt::all()) = 0.0;
   }
 }
 
+void Tally::nuc013_add_value(double value)
+{
+  const int lane = thread_num();
+  if (lane < 0 || static_cast<std::size_t>(lane) >=
+                    nuc013_event_by_thread_.size()) {
+    fatal_error("NUC-013 OpenMP tally lane index is out of bounds");
+  }
+  nuc013_event_by_thread_[lane].add(static_cast<long double>(value));
+}
+
+vector<double> Tally::nuc013_checkpoint_state() const
+{
+  auto append = [](vector<double>& state, long double value) {
+    const double high = static_cast<double>(value);
+    const double low = static_cast<double>(value - static_cast<long double>(high));
+    state.push_back(high);
+    state.push_back(low);
+  };
+  vector<double> state;
+  state.reserve(8);
+  append(state, nuc013_sum_.sum);
+  append(state, nuc013_sum_.correction);
+  append(state, nuc013_sum_sq_.sum);
+  append(state, nuc013_sum_sq_.correction);
+  return state;
+}
+
+bool Tally::nuc013_restore_state(const vector<double>& state)
+{
+  if (!nuc013_compensation_ || state.size() != 8 ||
+      nuc013_event_by_thread_.size() !=
+        static_cast<std::size_t>(num_threads())) {
+    return false;
+  }
+  for (double value : state) {
+    if (!std::isfinite(value))
+      return false;
+  }
+  auto join = [&state](std::size_t i) {
+    return static_cast<long double>(state[i]) +
+           static_cast<long double>(state[i + 1]);
+  };
+  nuc013_sum_.sum = join(0);
+  nuc013_sum_.correction = join(2);
+  nuc013_sum_sq_.sum = join(4);
+  nuc013_sum_sq_.correction = join(6);
+  for (auto& lane : nuc013_event_by_thread_)
+    lane.clear();
+  return true;
+}
