diff --git a/src/state_point.cpp b/src/state_point.cpp
index 47296da..b58a122 100644
--- a/src/state_point.cpp
+++ b/src/state_point.cpp
@@ -4,0 +5 @@
+#include <limits>
@@ -115,0 +117,13 @@ extern "C" int openmc_statepoint_write(const char* filename, bool* write_source)
+    // Record the FARIS benchmark-only MCNP imp:n=0 diagnostics in the solver
+    // child that produced this statepoint, not in its parent process.
+    write_dataset(file_id, "faris_mcnp_imp0_patch_version",
+      faris_openmc_mcnp_imp0_patch_version);
+    write_dataset(file_id, "faris_mcnp_imp0_kill_events",
+      faris_openmc_mcnp_imp0_kill_events);
+    write_dataset(file_id, "faris_mcnp_imp0_birth_kill_events",
+      faris_openmc_mcnp_imp0_birth_kill_events);
+    write_dataset(file_id, "faris_mcnp_imp0_entry_kill_events",
+      faris_openmc_mcnp_imp0_entry_kill_events);
+    write_dataset(file_id, "faris_openmc_n_lost_particles",
+      simulation::n_lost_particles);
+
@@ -446,0 +461,51 @@ extern "C" int openmc_statepoint_load(const char* filename)
+  // Preserve the child process's intentional-kill and geometry-loss counts
+  // across patch-aware restarts. A model with an opt-in marker must not
+  // restart from a statepoint that predates this accounting.
+  const bool has_faris_marker = std::any_of(
+    model::cells.begin(), model::cells.end(), [](const auto& cell) {
+      return cell->faris_neutron_importance_zero_on_entry_;
+    });
+  const htri_t has_patch_dataset =
+    H5Lexists(file_id, "faris_mcnp_imp0_patch_version", H5P_DEFAULT);
+  const htri_t has_kill_dataset =
+    H5Lexists(file_id, "faris_mcnp_imp0_kill_events", H5P_DEFAULT);
+  if (has_patch_dataset < 0 || has_kill_dataset < 0) {
+    fatal_error("Could not inspect FARIS statepoint kill-accounting datasets.");
+  }
+  if (has_patch_dataset > 0 && has_kill_dataset > 0) {
+    int patch_version;
+    read_dataset(file_id, "faris_mcnp_imp0_patch_version", patch_version);
+    if (patch_version != faris_openmc_mcnp_imp0_patch_version) {
+      fatal_error("Statepoint uses an unsupported FARIS imp:n=0 patch version.");
+    }
+    read_dataset(file_id, "faris_mcnp_imp0_kill_events",
+      faris_openmc_mcnp_imp0_kill_events);
+    read_dataset(file_id, "faris_mcnp_imp0_birth_kill_events",
+      faris_openmc_mcnp_imp0_birth_kill_events);
+    read_dataset(file_id, "faris_mcnp_imp0_entry_kill_events",
+      faris_openmc_mcnp_imp0_entry_kill_events);
+    read_dataset(file_id, "faris_openmc_n_lost_particles",
+      simulation::n_lost_particles);
+    const bool kill_count_overflow =
+      faris_openmc_mcnp_imp0_entry_kill_events > 0 &&
+      faris_openmc_mcnp_imp0_birth_kill_events >
+        std::numeric_limits<int64_t>::max() -
+          faris_openmc_mcnp_imp0_entry_kill_events;
+    if (faris_openmc_mcnp_imp0_kill_events < 0 ||
+        faris_openmc_mcnp_imp0_birth_kill_events < 0 ||
+        faris_openmc_mcnp_imp0_entry_kill_events < 0 ||
+        kill_count_overflow ||
+        (!kill_count_overflow && faris_openmc_mcnp_imp0_kill_events !=
+          faris_openmc_mcnp_imp0_birth_kill_events +
+            faris_openmc_mcnp_imp0_entry_kill_events) ||
+        simulation::n_lost_particles < 0) {
+      fatal_error("Statepoint contains invalid FARIS particle event counts.");
+    }
+  } else if (has_faris_marker) {
+    fatal_error(
+      "A FARIS imp:n=0 model must restart from a statepoint with the "
+      "FARIS kill-accounting datasets.");
+  } else if (has_patch_dataset > 0 || has_kill_dataset > 0) {
+    fatal_error("Statepoint has incomplete FARIS kill-accounting datasets.");
+  }
+
