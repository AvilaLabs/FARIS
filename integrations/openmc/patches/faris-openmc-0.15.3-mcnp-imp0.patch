diff --git a/src/particle.cpp b/src/particle.cpp
index 2d70d71..5050791 100644
--- a/src/particle.cpp
+++ b/src/particle.cpp
@@ -195,0 +196,15 @@ void Particle::event_calculate_xs()
+
+    // MCNP terminates a neutron born in an importance-zero cell. Count this
+    // separately from a surface-entry kill, and from physical absorption or
+    // geometry loss. Photons are not affected by imp:n.
+    const int32_t cell_index = lowest_coord().cell();
+    if (type() == ParticleType::neutron && cell_index >= 0 &&
+        cell_index < static_cast<int32_t>(model::cells.size()) &&
+        model::cells[cell_index]->faris_neutron_importance_zero_on_entry_) {
+      wgt() = 0.0;
+#pragma omp atomic
+      faris_openmc_mcnp_imp0_kill_events += 1;
+#pragma omp atomic
+      faris_openmc_mcnp_imp0_birth_kill_events += 1;
+      return;
+    }
@@ -299,0 +315,22 @@ void Particle::event_cross_surface()
+  // Check after geometry has located the destination cell, but delay killing
+  // until after surface-current scoring below. This keeps the incoming weight
+  // on the face tally while preventing a zero-importance cell from receiving
+  // track length or a weight-window operation.
+  auto enters_faris_imp0_cell = [this]() {
+    if (!alive() || type() != ParticleType::neutron)
+      return false;
+    for (int level = 0; level < n_coord(); ++level) {
+      const int32_t cell_index = coord(level).cell();
+      const bool changed = level >= n_coord_last() ||
+                           cell_index != cell_last(level);
+      if (!changed || cell_index < 0 ||
+          cell_index >= static_cast<int32_t>(model::cells.size())) {
+        continue;
+      }
+      if (model::cells[cell_index]->faris_neutron_importance_zero_on_entry_)
+        return true;
+    }
+    return false;
+  };
+  bool faris_imp0_entry = false;
+
@@ -306,0 +344 @@ void Particle::event_cross_surface()
+    faris_imp0_entry = enters_faris_imp0_cell();
@@ -315,0 +354 @@ void Particle::event_cross_surface()
+    faris_imp0_entry = enters_faris_imp0_cell();
@@ -320 +359 @@ void Particle::event_cross_surface()
-    if (settings::weight_window_checkpoint_surface) {
+    if (settings::weight_window_checkpoint_surface && !faris_imp0_entry) {
@@ -328,0 +368,10 @@ void Particle::event_cross_surface()
+
+  if (faris_imp0_entry) {
+    // This intentional variance-reduction termination is not a geometry loss
+    // and must not increment simulation::n_lost_particles.
+    wgt() = 0.0;
+#pragma omp atomic
+    faris_openmc_mcnp_imp0_kill_events += 1;
+#pragma omp atomic
+    faris_openmc_mcnp_imp0_entry_kill_events += 1;
+  }
