diff --git a/src/cell.cpp b/src/cell.cpp
index e247999..cfb997a 100644
--- a/src/cell.cpp
+++ b/src/cell.cpp
@@ -358,0 +359,12 @@ CSGCell::CSGCell(pugi::xml_node cell_node)
+  // This opt-in attribute is injected by the benchmark adapter only after it
+  // verifies its MCNP-to-OpenMC cell map. It is not part of stock OpenMC XML.
+  const auto faris_neutron_importance =
+    cell_node.attribute("faris_neutron_importance");
+  if (faris_neutron_importance) {
+    if (std::string{faris_neutron_importance.value()} != "0") {
+      fatal_error(fmt::format(
+        "Only FARIS neutron importance 0 is supported on cell {}", id_));
+    }
+    faris_neutron_importance_zero_on_entry_ = true;
+  }
