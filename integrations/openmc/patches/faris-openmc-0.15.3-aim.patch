+//==============================================================================
+// Aperture and collision aiming (FARIS patch)
+//==============================================================================
+
+namespace {
+
+//! A rectangle c + s*u + t*v (s, t in [-1, 1]).
+struct Rect {
+  Position c, u, v, n;
+  double area {0.0};
+};
+
+//! OPENMC_APERTURE_BIAS="beta cx cy cz ux uy uz vx vy vz [; cx ... vz ...]"
+//! aims a fraction beta of source directions at the aperture: one or more
+//! rectangles, each picked with equal probability.
+struct Aperture {
+  bool on {false};
+  double beta {0.0};
+  vector<Rect> rects;
+  //! OPENMC_APERTURE_ONE_SIDED=1: a rectangle is aimed at only from points on
+  //! the side opposite its normal u x v, so the normal points toward the
+  //! response and particles past the aperture are not aimed back through it.
+  bool one_sided {false};
+};
+
+Rect parse_rect(const double* x)
+{
+  Rect r;
+  r.c = {x[0], x[1], x[2]};
+  r.u = {x[3], x[4], x[5]};
+  r.v = {x[6], x[7], x[8]};
+  Position cross = r.u.cross(r.v);
+  r.area = 4.0 * cross.norm();
+  if (r.area <= 0.0 || std::abs(r.u.dot(r.v)) > 1e-9 * r.u.norm() * r.v.norm())
+    fatal_error("OPENMC_APERTURE_BIAS: each rectangle needs orthogonal, "
+                "non-zero u and v");
+  r.n = cross / cross.norm();
+  return r;
+}
+
+const Aperture& aperture()
+{
+  static const Aperture ab = [] {
+    Aperture a;
+    const char* env = std::getenv("OPENMC_APERTURE_BIAS");
+    if (!env)
+      return a;
+    std::string all(env);
+    std::size_t start = 0;
+    bool first = true;
+    while (start <= all.size()) {
+      std::size_t end = all.find(';', start);
+      if (end == std::string::npos)
+        end = all.size();
+      std::istringstream in(all.substr(start, end - start));
+      vector<double> x;
+      double v;
+      while (in >> v)
+        x.push_back(v);
+      if (first) {
+        if (x.size() != 10)
+          fatal_error("OPENMC_APERTURE_BIAS needs beta and 9 numbers per "
+                      "rectangle (c u v), rectangles separated by ';'");
+        a.beta = x[0];
+        a.rects.push_back(parse_rect(&x[1]));
+        first = false;
+      } else {
+        if (x.size() != 9)
+          fatal_error("OPENMC_APERTURE_BIAS: each further rectangle needs 9 "
+                      "numbers (c u v)");
+        a.rects.push_back(parse_rect(&x[0]));
+      }
+      start = end + 1;
+    }
+    if (a.beta < 0.0 || a.beta >= 1.0)
+      fatal_error("OPENMC_APERTURE_BIAS: need 0 <= beta < 1");
+    const char* os = std::getenv("OPENMC_APERTURE_ONE_SIDED");
+    a.one_sided = os && std::string(os) == "1";
+    a.on = true;
+    double area = 0.0;
+    for (const auto& r : a.rects)
+      area += r.area;
+    write_message(fmt::format("Directions biased toward an aperture (source "
+                              "beta {}, {} rectangles, area {} cm2{}).",
+                    a.beta, a.rects.size(), area,
+                    a.one_sided ? ", one-sided" : ""),
+      5);
+    return a;
+  }();
+  return ab;
+}
