+//! Mixture sampling for an isotropic site: with probability beta aim at a
+//! uniform point of the aperture, otherwise keep the isotropic direction. The
+//! weight is the isotropic density over the mixture density at the final
+//! direction, so every tally stays unbiased.
+void apply_aperture_bias(SourceSite& site, uint64_t* seed)
+{
+  double beta = aperture_visible(site.r) ? aperture_beta() : 0.0;
+  if (prn(seed) < beta)
+    site.u = aperture_sample_direction(site.r, seed);
+  double mix = (1.0 - beta) + beta * 4.0 * PI * aperture_pdf(site.r, site.u);
+  site.wgt /= mix;
+}
