+    CollisionAim c;
+    const char* env = std::getenv("OPENMC_COLLISION_AIM");
+    if (!env)
+      return c;
+    std::istringstream in(env);
+    in >> c.beta;
+    std::string tok;
+    while (in >> tok) {
