+
+double rect_pdf(const Rect& a, Position r, Direction w)
+{
+  double denom = w.dot(a.n);
+  if (std::abs(denom) < 1e-12)
+    return 0.0;
+  double lam = (a.c - r).dot(a.n) / denom;
+  if (lam <= 0.0)
+    return 0.0;
+  Position q = r + w * lam - a.c;
+  double s = q.dot(a.u) / a.u.dot(a.u);
+  double t = q.dot(a.v) / a.v.dot(a.v);
+  if (std::abs(s) > 1.0 || std::abs(t) > 1.0)
+    return 0.0;
+  return lam * lam / (a.area * std::abs(denom));
+}
+
+//! Whether rectangle a can be aimed at from r
+bool rect_visible(const Aperture& ap, const Rect& a, Position r)
+{
+  return !ap.one_sided || (a.c - r).dot(a.n) > 0.0;
+}
+
+int n_visible(const Aperture& a, Position r)
+{
+  int n = 0;
+  for (const auto& rect : a.rects)
+    n += rect_visible(a, rect, r);
+  return n;
+}
+
+bool aperture_visible(Position r)
+{
+  const auto& a = aperture();
+  return a.on && n_visible(a, r) > 0;
+}
+
+double aperture_pdf(Position r, Direction w)
+{
+  const auto& a = aperture();
+  if (!a.on)
+    return 0.0;
+  int n = n_visible(a, r);
+  if (n == 0)
+    return 0.0;
+  double sum = 0.0;
+  for (const auto& rect : a.rects)
+    if (rect_visible(a, rect, r))
+      sum += rect_pdf(rect, r, w);
+  return sum / n;
+}
+
+//! Uniform point of a visible rectangle, each visible rectangle equally
+//! likely. Callers check aperture_visible(r) first.
+Direction aperture_sample_direction(Position r, uint64_t* seed)
+{
+  const auto& a = aperture();
+  int n = n_visible(a, r);
+  int k = 0;
+  if (n > 1)
+    k = std::min(static_cast<int>(prn(seed) * n), n - 1);
+  const Rect* pick = nullptr;
+  for (const auto& rect : a.rects) {
+    if (!rect_visible(a, rect, r))
+      continue;
+    if (k-- == 0) {
+      pick = &rect;
+      break;
+    }
+  }
+  double s = 2.0 * prn(seed) - 1.0;
+  double t = 2.0 * prn(seed) - 1.0;
+  Position d = pick->c + pick->u * s + pick->v * t - r;
+  return d / d.norm();
+}
+
+bool collision_aim_on()
+{
+  return collision_aim().beta > 0.0;
+}
+
+double collision_aim_beta(int material_index)
+{
+  const auto& c = collision_aim();
+  if (c.beta <= 0.0 || material_index < 0)
+    return 0.0;
+  if (c.all)
+    return c.beta;
+  int32_t id = model::materials[material_index]->id_;
+  for (auto m : c.material_ids)
+    if (m == id)
+      return c.beta;
+  return 0.0;
+}
+
+double ww_roulette_factor()
+{
+  static const double f = [] {
+    const char* v = std::getenv("OPENMC_WW_ROULETTE_FACTOR");
+    return v ? std::atof(v) : 0.0;
+  }();
+  return f;
+}
+
+bool ww_skip_void()
+{
+  static const bool on = [] {
+    const char* v = std::getenv("OPENMC_WW_SKIP_VOID");
+    return v && std::string(v) == "1";
+  }();
