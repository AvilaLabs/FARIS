+}
+
+bool split_before_collision()
+{
+  static const bool on = [] {
+    const char* v = std::getenv("OPENMC_SPLIT_BEFORE_COLLISION");
+    bool enabled = v && std::string(v) == "1";
+    if (enabled)
+      write_message("Weight windows split before the collision reaction.", 5);
+    return enabled;
+  }();
+  return on;
+}
+
+int weight_window_split_count(Particle& p)
+{
+  if (!settings::weight_windows_on || p.type() != ParticleType::neutron)
+    return 1;
+  if (p.E() <= 0 || !p.alive())
+    return 1;
+
+  // Same window, birth scaling and far-above factor as apply_weight_windows
+  WeightWindow weight_window;
+  for (const auto& ww : variance_reduction::weight_windows) {
+    weight_window = ww->get_weight_window(p);
+    if (weight_window.is_valid())
+      break;
+  }
+  if (p.wgt_ww_born() == -1.0) {
+    if (weight_window.is_valid()) {
+      p.wgt_ww_born() =
+        (weight_window.lower_weight + weight_window.upper_weight) / 2;
+    } else {
+      p.wgt_ww_born() = 1.0;
+    }
+  }
+  if (!weight_window.is_valid())
+    return 1;
+  weight_window.scale(p.wgt_born() / p.wgt_ww_born());
+  if (p.ww_factor() == 0.0 && weight_window.max_lb_ratio > 1.0 &&
+      p.wgt() > weight_window.lower_weight * weight_window.max_lb_ratio) {
+    p.ww_factor() =
+      p.wgt() / (weight_window.lower_weight * weight_window.max_lb_ratio);
+  }
+  if (p.ww_factor() > 1.0)
+    weight_window.scale(p.ww_factor());
+
+  if (p.wgt() <= weight_window.upper_weight ||
+      p.n_split() >= settings::max_history_splits)
+    return 1;
+  double n_split = std::min(std::ceil(p.wgt() / weight_window.upper_weight),
+    static_cast<double>(weight_window.max_split));
+  p.n_split() += n_split;
+  return static_cast<int>(std::round(n_split));
+}
