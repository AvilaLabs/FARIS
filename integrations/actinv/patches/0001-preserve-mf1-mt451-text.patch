     #[test]
+    fn mf1_mt451_text_is_byte_preserved_and_numeric_nan_still_normalizes() {
+        fn line(fields: [&str; 6], mat: i32, mf: i32, mt: i32, ns: i32) -> String {
+            let mut out = String::new();
+            for field in fields {
+                assert!(field.len() <= 11);
+                out.push_str(&format!("{field:>11}"));
+            }
+            out.push_str(&format!("{mat:>4}{mf:>2}{mt:>3}{ns:>5}\n"));
+            out
+        }
+        fn text_line(text: &str, mat: i32, ns: i32) -> String {
+            assert!(text.len() <= 66);
+            format!("{:<66}{:>4}{:>2}{:>3}{:>5}\n", text, mat, 1, 451, ns)
+        }
+
+        let mat = 125;
+        let mut tape = String::new();
+        tape.push_str(&line(["1.001000+3", "9.991673-1", "0", "0", "0", "0"], mat, 1, 451, 1));
+        tape.push_str(&line(["0", "0", "0", "0", "0", "6"], mat, 1, 451, 2));
+        tape.push_str(&line(["1", "2.000000+7", "1", "0", "10", "2025"], mat, 1, 451, 3));
+        tape.push_str(&line(["0", "0", "0", "0", "3", "1"], mat, 1, 451, 4));
+        let text_records = [
+            text_line("1-H -  1 TEST EVAL-JUL16 author text", mat, 5),
+            text_line("REF: DATA NaN text must remain unchanged", mat, 6),
+            text_line("---- ENDF/B metadata text", mat, 7),
+        ];
+        for record in &text_records {
+            tape.push_str(record);
+        }
+        // Numeric directory record after the NWD text block.
+        tape.push_str(&line(["NaN", "0", "9", "451", "1", "0"], mat, 1, 451, 8));
+        tape.push_str(&line(["0", "0", "0", "0", "0", "0"], mat, 1, 0, 99999));
+        // The existing numeric-field repair remains active in reaction data.
+        tape.push_str(&line(["NaN", "1", "3", "4", "5", "6"], mat, 3, 102, 1));
+        tape.push_str(&line(["7", "8", "9", "10", "11", "12"], mat, 3, 102, 2));
+
+        let out = normalize_tape(&tape, NormalizeProfile::EndfB8);
+        let rows: Vec<&str> = out.text.lines().collect();
+        for (index, expected) in text_records.iter().enumerate() {
+            assert_eq!(rows[4 + index], expected.trim_end_matches('\n'));
+        }
+        let mut expected_text_block = String::new();
+        for record in &text_records {
+            expected_text_block.push_str(record);
+        }
+        assert!(out.text.contains(&expected_text_block));
+        let expected_directory = ef_str(9.0);
+        let expected_reaction = ef_str(3.0);
+        assert_eq!(&rows[7][..11], expected_directory.as_str());
+        assert_eq!(&rows[9][..11], expected_reaction.as_str());
+        assert_eq!(
+            out.entries
+                .iter()
+                .filter(|entry| entry.starts_with("nan_field:"))
+                .count(),
+            2,
+            "only the numeric directory and reaction fields are repaired: {:?}",
+            out.entries
+        );
+    }
